digraph G { graph [bgcolor="#ffffff",pad="0.35",nodesep="0.5",ranksep="0.65",fontname="Heiti SC",fontsize=20]; node [shape=box,style="rounded,filled",fillcolor="#F3F6FA",color="#BCC9D7",fontname="Heiti SC",fontsize=16,margin="0.20,0.15"]; edge [color="#64748B",fontname="Heiti SC",fontsize=12,arrowsize=0.7];node[shape=plain];batch[label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#BBC9D8"><TR><TD COLSPAN="4" BGCOLOR="#DCEAF8"><B>review_batch · 审核批次 · 新增</B></TD></TR><TR><TD>键</TD><TD>字段名</TD><TD>类型</TD><TD>中文含义</TD></TR><TR><TD ALIGN="LEFT" PORT="left_id">PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT" PORT="right_id">批次ID</TD></TR><TR><TD ALIGN="LEFT" PORT="left_requester_id">UK¹</TD><TD ALIGN="LEFT">requester_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT" PORT="right_requester_id">提交人</TD></TR><TR><TD ALIGN="LEFT" PORT="left_request_key">UK¹</TD><TD ALIGN="LEFT">request_key</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT" PORT="right_request_key">请求标识</TD></TR><TR><TD ALIGN="LEFT" PORT="left_request_hash"></TD><TD ALIGN="LEFT">request_hash</TD><TD ALIGN="LEFT">varchar(64)</TD><TD ALIGN="LEFT" PORT="right_request_hash">请求摘要</TD></TR><TR><TD ALIGN="LEFT" PORT="left_action"></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">varchar(16)</TD><TD ALIGN="LEFT" PORT="right_action">审核操作</TD></TR><TR><TD ALIGN="LEFT" PORT="left_created_at"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT" PORT="right_created_at">创建时间</TD></TR><TR><TD ALIGN="LEFT" PORT="left_completed_at"></TD><TD ALIGN="LEFT">completed_at</TD><TD ALIGN="LEFT">timestamptz?</TD><TD ALIGN="LEFT" PORT="right_completed_at">完成时间</TD></TR></TABLE> >];}